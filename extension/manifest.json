{
  "manifest_version": 3,
  "name": "Directions To",
  "version": "1.0.0",
  "description": "Right-click selected place text to open Google Maps directions from a saved starting place.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Directions To settings",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  }
}
